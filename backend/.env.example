# Server Configuration
PORT=8000
ENVIRONMENT=development
DEBUG=true
ALLOW_UNVERIFIED_JWT=false
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://127.0.0.1:19006
SUPPORT_EMAIL=support@prezzence.app

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Services
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
AI_SCORING_PROVIDER=groq
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional only when AI_SCORING_PROVIDER=gemini.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GEMINI_MODEL=gemini-2.0-flash
QUESTION_PROVIDER_TIMEOUT_SECONDS=12
QUESTION_GENERATION_TIMEOUT_SECONDS=3.5
SESSION_DB_TIMEOUT_SECONDS=8
SESSION_META_TIMEOUT_SECONDS=4
SESSION_ANALYTICS_TIMEOUT_SECONDS=2
SESSION_WEB_RESEARCH_TIMEOUT_SECONDS=6
PROGRESS_QUERY_TIMEOUT_SECONDS=12
TOKEN_CACHE_TTL_SECONDS=300

# Optional web research for company-specific interviews
# Uses Tavily search when enabled. If no key is set, pasted company context still works.
WEB_RESEARCH_ENABLED=true
TAVILY_API_KEY=your_tavily_api_key
WEB_RESEARCH_TIMEOUT_SECONDS=12
WEB_RESEARCH_MAX_RESULTS=5

# Redis Configuration (Upstash)
REDIS_URL=your_upstash_redis_url
REDIS_TOKEN=your_upstash_redis_token

# JWT Secret (for validation)
JWT_SECRET=your_jwt_secret_from_supabase

# Device enforcement (recommended beta defaults)
DEVICE_LIMIT_ENFORCED=false
DEVICE_LIMIT_HARD_FAIL=false
MAX_DEVICES_PER_USER=2

# Production safety:
# ENVIRONMENT=production
# DEBUG=false
# ALLOW_UNVERIFIED_JWT=false
# TTS_STORAGE_BACKEND=supabase
# BETA_UNLOCK_ALL_FEATURES=false

# Google Play Billing (server-side subscription verification)
# Create a service account in Google Cloud, enable Android Publisher API,
# link it in Play Console > API access, then paste JSON or file path:
GOOGLE_PLAY_PACKAGE_NAME=com.pollecode.prezzencekotlin
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=/path/to/play-service-account.json
# Use 0 during beta/testing while store billing is not connected.
FREE_SESSION_LIMIT=3
RATE_LIMIT_SESSION_CREATE_MAX=12
RATE_LIMIT_SESSION_CREATE_WINDOW=3600
RATE_LIMIT_ANSWER_ANALYSIS_MAX=80
RATE_LIMIT_ANSWER_ANALYSIS_WINDOW=3600
RATE_LIMIT_TTS_MAX=180
RATE_LIMIT_TTS_WINDOW=3600
RATE_LIMIT_ANALYTICS_MAX=600
RATE_LIMIT_ANALYTICS_WINDOW=3600

# TTS Storage
# Use local for development. Production startup requires supabase/object storage.
TTS_STORAGE_BACKEND=local
TTS_STORAGE_BUCKET=tts
# Default to WAV so the same backend audio can drive Duix lip sync without phone-side MP3 conversion.
TTS_AUDIO_FORMAT=wav

# Duix model zips are intentionally not bundled in the Android app.
# Upload Sofia.zip, Oliver.zip, and Lily.zip to this base URL.
# gj_dh_res.zip is too large for Supabase free storage and can use the official Duix release URL.
DUIX_MODEL_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/duix-models
DUIX_BASE_CONFIG_URL=https://github.com/duixcom/Duix-Mobile/releases/download/v1.0.0/gj_dh_res.zip
TTS_MAX_FILE_AGE_SECONDS=86400
TTS_CLEANUP_INTERVAL_SECONDS=900
