# Copy these into Render → prezzence-backend → Environment
# Then redeploy the backend so assetlinks + billing use production values.

ENVIRONMENT=production
DEBUG=false
BETA_UNLOCK_ALL_FEATURES=false

# Production Play listing (must match the AAB applicationId)
GOOGLE_PLAY_PACKAGE_NAME=com.pollecode.prezzence
ANDROID_APP_PACKAGE_NAMES=com.pollecode.prezzence

# Play Console → Test and release → App integrity → App signing
# Copy the SHA-256 under "App signing key certificate" (NOT the upload key).
ANDROID_APP_SHA256_FINGERPRINTS=PASTE_PLAY_APP_SIGNING_SHA256_HERE

# Play Console → API access → service account with "Manage orders and subscriptions"
# Paste the full JSON on one line, or mount the file and set GOOGLE_PLAY_SERVICE_ACCOUNT_FILE.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Subscription product ID (must match Play Console → Monetize → Subscriptions)
# App reads price dynamically; create + activate prezzence_pro before marketing paid plans.

# Optional: block untrusted devices after you have watched integrity verdicts
PLAY_INTEGRITY_ENFORCED=false

# RTDN Pub/Sub push target (configure in Play Console → Monetization setup)
# https://prezzence-backend.onrender.com/api/billing/google/rtdn
